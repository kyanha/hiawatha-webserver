#! /bin/sh

### BEGIN INIT INFO
# Provides:          hiawatha httpd httpd-cgi
# Required-Start:    $syslog $network $remote_fs
# Required-Stop:     $syslog $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Hiawatha webserver
# Description:       Hiawatha, a secure and advanced webserver.
### END INIT INFO

NAME=hiawatha
DAEMON=/usr/local/sbin/hiawatha
PIDFILE=/usr/local/var/run/hiawatha.pid
WIGWAM=/usr/local/sbin/wigwam

# /etc/init.d/hiawatha: start and stop the Hiawatha webserver daemon


case "$1" in
        start)
                $WIGWAM -q || exit 1
                $DAEMON
                if [ $? -eq 0 ]; then
                        echo "Hiawatha webserver started."
                else
                        echo "Hiawatha webserver was already running."
                        exit 1
                fi
                ;;

        stop)
                echo "Stopping Hiawatha webserver..."
                PID=$(pgrep "$NAME")
                if [ $? -eq 0 ]; then
                        rm -f $PIDFILE
                        pkill -F $DAEMON
                        echo "Hiawatha stopped."
                else
                        echo "Hiawatha was not running!"
                        exit 1
                fi
                ;;

        restart)
                echo "Restarting Hiawatha."
                PID=$(pgrep "$NAME")
                if [ $? -eq 0 ]; then
                        echo "Stopping Hiawatha webserver..."
                        rm -f $PIDFILE
                        pkill -F $DAEMON
                        echo "Hiawatha stopped."
                fi
                sleep 2
                $WIGWAM -q || exit 1
                $DAEMON
                echo "Hiawatha webserver started."
                ;;

        check)
                echo "==[ Check by Wigwam"
                $WIGWAM
                echo
                echo "==[ Check by Hiawatha"
                $DAEMON -k
                ;;

        status)
                #nothing here yet
                ;;

        *)
                echo "Usage: /etc/init.d/hiawatha {start|stop|restart|check|status}" || true
                exit 1
esac

exit 0
