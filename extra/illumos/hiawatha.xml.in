<?xml version="1.0"?>
<!DOCTYPE service_bundle SYSTEM "/usr/share/lib/xml/dtd/service_bundle.dtd.1">
<!--
-->
<service_bundle type="manifest" name="hiawatha">
    <service name="network/hiawatha" type="service" version="1">
        <create_default_instance enabled="true" />
        <single_instance/>

        <dependency name="loopback"
                    grouping="require_all"
                    restart_on="error"
                    type="service">
            <service_fmri value="svc:/network/loopback" />
        </dependency>

        <dependency name="network"
                    grouping="optional_all"
                    restart_on="error"
                    type="service">
            <service_fmri value="svc:/milestone/network" />
        </dependency>

        <dependency name="filesystem_local"
                    grouping="require_all"
                    restart_on="none"
                    type="service">
            <service_fmri value="svc:/system/filesystem/local:default" />
        </dependency>

        <exec_method type="method"
                    name="start"
                    exec="%{config/wigwam} -q && %{config/hiawatha}"
                    timeout_seconds="60">
            <method_context security_flags="aslr">
                    <method_credential user="root"
                                       group="root"
                                       privileges="basic,net_privaddr,!proc_info,!proc_session,!file_link_any" />
            </method_context>
        </exec_method>

        <exec_method type="method"
                    name="stop"
                    exec="kill %{config/pidfile}"
                    timeout_seconds="300" />

        <exec_method type="method"
                    name="refresh"
                    exec="kill %{config/pidfile} && %{config/wigwam} -q && %{config/hiawatha}"
                    timeout_seconds="300" />

        <property_group name="config"
                    type="application">
            <propval name="pidfile"
                    type="astring"
                    value="${CMAKE_INSTALL_FULL_LOCALSTATEDIR}/run/hiawatha.pid" />
            <propval name="hiawatha"
                    type="astring"
                    value="${CMAKE_INSTALL_SBINDIR}/hiawatha" />
            <propval name="wigwam"
                    type="astring"
                    value="${CMAKE_INSTALL_SBINDIR}/wigwam" />
            <propval name="version"
                    type="astring"
                    value="${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}" />
        </property_group>

        <template>
            <common_name>
                <loctext xml:lang="C">hiawatha %{config/version}</loctext>
            </common_name>
        </template>

        <stability value="External" />
    </service>
</service_bundle>
